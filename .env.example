# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# OpenAI API Keys
OPENAI_API_KEY=sk-xxxxxxxxx
OPENAI_ADMIN_KEY=sk-xxxxxxxxx
OPENAI_ORG_ID=your-org-id
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxx

# DeepSeek API Keys
DEEPSEEK_API_KEY=sk-xxxxxxxxx

# Google Gemini API Keys
GEMINI_API_KEY=xxxxxxxxx

# Vault Configuration
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root
VAULT_NAMESPACE=agent-rl

# Local LLM
LOCAL_LLM_URL=http://localhost:11434/v1

# Database
POSTGRES_PASSWORD=your-password
POSTGRES_DB=agentrl

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Default Provider
DEFAULT_PROVIDER=openai

# OCR Configuration (选择一种OCR提供商配置)
# 百度OCR
BAIDU_OCR_API_KEY=your-baidu-api-key
BAIDU_OCR_SECRET_KEY=your-baidu-secret-key

# 腾讯云OCR
TENCENT_OCR_SECRET_ID=your-tencent-secret-id
TENCENT_OCR_SECRET_KEY=your-tencent-secret-key

# 阿里云OCR
ALIBABA_OCR_ACCESS_KEY_ID=your-alibaba-access-key-id
ALIBABA_OCR_ACCESS_KEY_SECRET=your-alibaba-access-key-secret

# Tesseract本地OCR（免费，无需API Key，但需要安装tesseract-ocr）
# Windows: https://github.com/UB-Mannheim/tesseract/wiki
# Linux: sudo apt install tesseract-ocr tesseract-ocr-chi-sim